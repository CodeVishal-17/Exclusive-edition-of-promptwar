# Copy to .env for local development. Never commit .env (it is git-ignored).

# Recommended: Gemini API key from Google AI Studio (no Google Cloud project or billing needed).
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional (defaults shown)
# GEMINI_MODEL=gemini-3.6-flash
# GEMINI_TIMEOUT_MS=60000
# GEMINI_MAX_RETRIES=1
# RATE_LIMIT_PER_MINUTE=20
# CACHE_ENTRIES=100
# CACHE_TTL_MS=900000
# PORT=8080

# Alternative (only if you have a Google Cloud project with billing): Vertex AI.
# Leave GEMINI_API_KEY empty, run `gcloud auth application-default login`, then set:
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global
